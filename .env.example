# Supabase project settings (Project Settings > API).
# The anon key is safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Phase 2: Google Calendar (server only, never prefixed NEXT_PUBLIC_) ----
# Service-role key (Project Settings > API Keys > service_role). Bypasses RLS:
# used only by the calendar server routes. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
# The Google Cloud OAuth web client (same one Supabase uses for sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; Vercel Cron sends it to /api/cron/calendar.
CRON_SECRET=
# Optional: the public site address (default https://ourhomehub.nl) and the
# family account suggested on Google's consent screen.
# SITE_URL=https://ourhomehub.nl
# FAMILY_CALENDAR_ACCOUNT=wasserfallfamilie@gmail.com
